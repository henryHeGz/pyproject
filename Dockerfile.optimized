# 优化版 Dockerfile - 使用 Playwright 官方镜像
# 预计镜像大小: 1.0-1.2GB (相比当前的 1.63GB)

FROM mcr.microsoft.com/playwright/python:v1.49.0-jammy AS base

# 设置工作目录
WORKDIR /app

# 复制应用代码
COPY . .

# 安装Python依赖
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -e .

# 创建必要的目录
RUN mkdir -p csv_exports flfg_downloads logs /app/data

# 设置环境变量
ENV PYTHONUNBUFFERED=1 \
    DB_TYPE=sqlite \
    SQLITE_DB_PATH=/app/data/chinatax.db

# 暴露端口
EXPOSE 8000

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/api/database/stats')" || exit 1

# 启动命令
CMD ["python", "docker_entrypoint.py"]
