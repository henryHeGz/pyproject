# 数据库配置
# 数据库类型: sqlite 或 mysql
DB_TYPE=sqlite

# SQLite 配置（当 DB_TYPE=sqlite 时使用）
SQLITE_DB_PATH=chinatax.db

# MySQL/PostgreSQL 配置（当 DB_TYPE=mysql 时使用）
# 注意：虽然变量名是 MYSQL_*，但也可以用于 PostgreSQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=chinatax
MYSQL_PASSWORD=your_password_here
MYSQL_DATABASE=chinatax

# 应用配置
PYTHONUNBUFFERED=1
